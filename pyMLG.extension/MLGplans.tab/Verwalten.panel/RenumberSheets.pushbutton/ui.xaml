<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{{titel}}"
        Width="520" Height="520" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        FontSize="12">
    <DockPanel Margin="14">
        <TextBlock x:Name="lbl_info" DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{{start}}" Margin="0,0,0,3"/>
                <TextBox x:Name="tb_start"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{{schritt}}" Margin="0,0,0,3"/>
                <TextBox x:Name="tb_schritt"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="{{reihenfolge}}" Margin="0,0,0,3"/>
                <ComboBox x:Name="cb_reihenfolge"/>
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btn_ok" Content="{{ok}}" Width="120" Height="26"
                    Margin="0,0,8,0" IsDefault="True"/>
            <Button x:Name="btn_cancel" Content="{{abbrechen}}" Width="90" Height="26"
                    IsCancel="True"/>
        </StackPanel>
        <TextBlock x:Name="lbl_status" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   TextWrapping="Wrap" Foreground="#C03A3A"/>

        <ListBox x:Name="lb_vorschau" FontFamily="Consolas"/>
    </DockPanel>
</Window>
